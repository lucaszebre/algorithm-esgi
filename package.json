{
  "name": "algo-framework",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node --test --test-reporter=./tests/reporter.ts \"tests/**/*.test.ts\"",
    "test:watch": "node --test --watch --test-reporter=./tests/reporter.ts \"tests/**/*.test.ts\"",
    "test:raw": "node --test \"tests/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
